# ==============================================================================
# CTARTech ZentyCore — Environment Configuration Template
# ==============================================================================

# Server Ports
PORT=8080
DASHBOARD_PORT=3000

# Database Configuration (PostgreSQL)
POSTGRES_USER=zentycore
POSTGRES_PASSWORD=zentysecret
POSTGRES_DB=zentycore_db
DATABASE_URL=postgres://zentycore:zentysecret@localhost:5432/zentycore_db

# Cache Configuration (Redis)
REDIS_URL=redis://localhost:6379

# Frontend URLs
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:8080/ws/soc-stream

# Logging
RUST_LOG=info
